# ========================================
# .dockerignore - Exclude dari Docker image
# ========================================

# Documentation
docs/
README.md
*.md

# Git
.git/
.gitignore

# Docker files (tidak perlu masuk image)
Dockerfile
docker-compose.yml
.dockerignore

# Node modules (kalau ada)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Logs & temp
*.log
.tmp/
temp/
